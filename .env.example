# Copy to .env.local for local Vercel development. Set deployment values in Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never commit the value or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: comma-separated email addresses allowed to administer the app.
SUPABASE_ADMIN_EMAILS=
# Optional: the single admin account allowed to view profit. Defaults to the
# primary account established in supabase-rbac-setup.sql.
PROFIT_OWNER_EMAIL=adarshyadavazm123@gmail.com
